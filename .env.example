# Copy this file to .env and fill in your values.
# The application loads settings from .env automatically on startup.

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=http://localhost:6333/dashboard#
QDRANT_PORT=6333
COLLECTION_NAME=persian_docs

# ── Embedding model ───────────────────────────────────────────────────────────
# paraphrase-multilingual-MiniLM-L12-v2 supports Persian + 50 other languages.
# Change VECTOR_SIZE if you switch to a different model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_SIZE=384

# ── LLM (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=AIzaSyDrqCX_ocdVbrF9Y68mc_COwlmLSYzMIGY
LLM_MODEL=gpt-4o-mini

# ── OCR (Tesseract) ───────────────────────────────────────────────────────────
# Update this path if Tesseract is installed elsewhere on your system.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# fas = Farsi/Persian, eng = English (keeps URLs and mixed-language content)
OCR_LANG=fas+eng

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=200      # words per chunk
CHUNK_OVERLAP=30    # words shared between consecutive chunks

# ── Ingestion ─────────────────────────────────────────────────────────────────
UPLOAD_BATCH_SIZE=100
# PDF pages with fewer than this many characters trigger OCR fallback
OCR_FALLBACK_THRESHOLD=50
